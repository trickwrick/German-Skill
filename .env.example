# Local saves use data/blog-store.json automatically. Set COURSE_STORE=mongodb to force Atlas locally.
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_TLS_INSECURE=true
# Required on Vercel: set both MONGODB_URI and MONGODB_TLS_INSECURE=true in project env vars.
# In MongoDB Atlas: Network Access -> allow 0.0.0.0/0 for Vercel deployments.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SESSION_TOKEN=your_long_random_session_token_here
